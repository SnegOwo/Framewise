{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framewise",
  "version": "1.0.2",
  "identifier": "dev.sneghq.framewise",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Framewise",
        "width": 1200,
        "height": 840,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A quiet, offline time tracker for Adobe creatives.",
    "longDescription": "Framewise measures active foreground time per application and attributes Adobe app time to the project you are working on. Offline, local, and lightweight.",
    "copyright": "Copyright (c) 2026 Sneg HQ",
    "publisher": "Sneg HQ",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SnegOwo/Framewise/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxMTNDNDRDOERBMUJDOTgKUldTWXZLR05UTVFUMGQreGxkTWtjVURvQ3p2RXR3a3VXejlmMUhyZS9nMnZBR1o3M2QzTVZiamUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
